#!/usr/bin/env bash
# Run octoflow-ai's quality gate on this working tree: the tests with coverage, then
# gate.py, which judges the change since BASE and writes quality.md at the repo root.
#
#   scripts/gate [BASE]     BASE is any git revision; default main.
#
# gate.py's rules are BASE's pyproject.toml, so a change cannot loosen them; the tree's own
# only when BASE has no pyproject.toml. pytest's and coverage's options and the tool
# versions in uv.lock are still the tree's, which is why auto-merge, where it is set up,
# lands only Python and Markdown outside them (.github/workflows/automerge.yml). What
# each check means is in https://github.com/DavidSiegl/octoflow-ai/blob/main/docs/quality-gate.md
#
# Exit status: 0 for GATE: OK, 1 for GATE: ERROR (quality.md says why), 2 when the change
# could not be judged: this script failing before gate.py runs (no download, a hash
# mismatch, pytest unable to run the tests, BASE not a commit), or gate.py ending without
# a verdict. A failing test does not stop the run; the gate reports it.
#
# gate.py is downloaded once per pinned commit into $XDG_CACHE_HOME/octoflow-gate/, and
# each run executes a copy of it checked against the pinned SHA-256 after the tests, so a
# test cannot leave a changed gate.py for later runs. Within a run the tests, running as
# the same user, can still reach gate.py's interpreter and tools: agent-estate's TODO.md,
# "The judged code can still tamper with the judge". To move to a newer gate, change both
# pins.
set -euo pipefail
# git must read BASE's objects as they are, not as a refs/replace/ entry the tests wrote.
export GIT_NO_REPLACE_OBJECTS=1
# Any failure before gate.py runs is "could not judge", whatever the command's status.
trap 'exit 2' ERR

gate_commit=c0f6f32b5588ad19a781781406d8342849a9ca45 # octoflow-ai v0.57.5
gate_sha256=2165e8f2217f473974a21f1c5538aa6887d1df56fbabfa11319226dfbfa180a3

base=${1:-main}
cache="${XDG_CACHE_HOME:-$HOME/.cache}/octoflow-gate/$gate_commit"

top=$(git rev-parse --show-toplevel)
cd "$top"
# The reports and the verdict are gitignored and outlive a run: remove them so a pytest
# that writes none cannot leave gate.py the last run's, nor a run that ends early the last
# verdict.
rm -f test-results.xml coverage.xml quality.md

# pinned FILE: whether FILE is the pinned gate.py.
pinned() {
	echo "$gate_sha256  $1" | sha256sum --check --status
}

if [[ ! -f $cache/gate.py ]]; then
	mkdir -p "$cache"
	# Checked, then renamed within its directory, so neither a wrong download nor a
	# partial file ever sits under the name another run reads.
	tmp=$(mktemp "$cache/gate.py.XXXXXX")
	trap 'rm -f "$tmp"' EXIT
	curl -fsSL "https://raw.githubusercontent.com/DavidSiegl/octoflow-ai/$gate_commit/gate.py" -o "$tmp"
	if ! pinned "$tmp"; then
		echo "gate: downloaded gate.py does not match the pinned SHA-256" >&2
		exit 2
	fi
	mv "$tmp" "$cache/gate.py"
	trap - EXIT
fi

# Resolved before the tests run, which could move a ref.
if ! base=$(git rev-parse --verify --quiet "$base^{commit}"); then
	echo "gate: ${1:-main} is not a commit" >&2
	exit 2
fi

# pytest exits 1 when tests failed, which the gate judges; anything else means the tests
# did not run (https://docs.pytest.org/en/stable/reference/exit-codes.html).
status=0
uv run pytest --cov=hyprmuse --cov-branch --cov-report=xml --junitxml=test-results.xml || status=$?
if ((status > 1)); then
	echo "gate: pytest exited $status, so the tests did not run" >&2
	exit 2
fi

# The judge and its rules are copied only now that the tests have run, and any quality.md
# they wrote is removed.
rm -f quality.md
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cp "$cache/gate.py" "$work/gate.py"
if ! pinned "$work/gate.py"; then
	echo "gate: $cache/gate.py does not match the pinned SHA-256; delete it to download it again" >&2
	exit 2
fi
rules=()
if git cat-file -e "$base:pyproject.toml" 2>/dev/null; then
	git show "$base:pyproject.toml" >"$work/pyproject.toml"
	rules=(--config "$work/pyproject.toml")
fi

trap - ERR
status=0
# -I: nothing on sys.path from gate.py's directory, the working directory or PYTHON*.
uv run python -I "$work/gate.py" --base "$base" "${rules[@]}" --tests test-results.xml --coverage coverage.xml \
	--out quality.md || status=$?
case $status in
0) ;;
1)
	# gate.py exits 1 for GATE: ERROR, but so does Python on an uncaught exception.
	if [[ $(head -n 1 quality.md 2>/dev/null) != "GATE: ERROR" ]]; then
		echo "gate: gate.py exited 1 without writing a verdict" >&2
		status=2
	fi
	;;
*) status=2 ;;
esac
exit "$status"
