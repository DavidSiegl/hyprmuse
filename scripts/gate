#!/usr/bin/env bash
# Run octoflow-ai's quality gate on this working tree: the tests with coverage, then
# gate.py, which judges the change since BASE and writes quality.md at the repo root.
#
#   scripts/gate [BASE]     BASE is any git revision; default main.
#
# The rules are BASE's pyproject.toml, so a change cannot loosen the rules it is judged
# by; the tree's own only when BASE has no pyproject.toml. What each check means is in
# https://github.com/DavidSiegl/octoflow-ai/blob/main/docs/quality-gate.md
#
# Exit status is gate.py's: 0 for GATE: OK, 1 for GATE: ERROR, 2 when it could not
# judge the change, which includes this script failing before gate.py runs (no download,
# a hash mismatch, pytest unable to run the tests). A failing test does not stop the
# run; the gate reports it.
#
# gate.py is downloaded once per pinned commit into $XDG_CACHE_HOME/octoflow-gate/
# and refused unless its SHA-256 matches. To move to a newer gate, change both pins.
set -euo pipefail
# Any failure before gate.py runs is "could not judge", whatever the command's status.
trap 'exit 2' ERR

gate_commit=c0f6f32b5588ad19a781781406d8342849a9ca45 # octoflow-ai v0.57.5
gate_sha256=2165e8f2217f473974a21f1c5538aa6887d1df56fbabfa11319226dfbfa180a3

base=${1:-main}
cache="${XDG_CACHE_HOME:-$HOME/.cache}/octoflow-gate/$gate_commit"
gate="$cache/gate.py"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

if [[ ! -f $gate ]]; then
	mkdir -p "$cache"
	curl -fsSL "https://raw.githubusercontent.com/DavidSiegl/octoflow-ai/$gate_commit/gate.py" -o "$work/gate.py"
	if ! echo "$gate_sha256  $work/gate.py" | sha256sum --check --status; then
		echo "gate: downloaded gate.py does not match the pinned SHA-256" >&2
		exit 2
	fi
	mv "$work/gate.py" "$gate"
fi

top=$(git rev-parse --show-toplevel)
cd "$top"
rules=()
if git cat-file -e "$base:pyproject.toml" 2>/dev/null; then
	git show "$base:pyproject.toml" >"$work/pyproject.toml"
	rules=(--config "$work/pyproject.toml")
fi

# The reports are gitignored and outlive a run: remove them so a pytest that writes none
# cannot leave gate.py the last run's.
rm -f test-results.xml coverage.xml
# pytest exits 1 when tests failed, which the gate judges; anything else means the tests
# did not run (https://docs.pytest.org/en/stable/reference/exit-codes.html).
status=0
uv run pytest --cov=hyprmuse --cov-branch --cov-report=xml --junitxml=test-results.xml || status=$?
if ((status > 1)); then
	echo "gate: pytest exited $status, so the tests did not run" >&2
	exit 2
fi
trap - ERR
uv run python "$gate" --base "$base" "${rules[@]}" --tests test-results.xml --coverage coverage.xml --out quality.md
