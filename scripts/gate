#!/usr/bin/env bash
# Run octoflow-ai's quality gate on this working tree: the tests with coverage, then
# gate.py, which judges the change since BASE and writes quality.md at the repo root.
#
#   scripts/gate [BASE]     BASE is any git revision; default main.
#
# Exit status is gate.py's: 0 for GATE: OK, 1 for GATE: ERROR, 2 when it could not
# judge the change. A failing test does not stop the run; the gate reports it.
# The rules come from pyproject.toml; what each check means is in
# https://github.com/DavidSiegl/octoflow-ai/blob/main/docs/quality-gate.md
#
# gate.py is downloaded once per pinned commit into $XDG_CACHE_HOME/octoflow-gate/
# and refused unless its SHA-256 matches. To move to a newer gate, change both pins.
set -euo pipefail

gate_commit=c0f6f32b5588ad19a781781406d8342849a9ca45 # octoflow-ai v0.57.5
gate_sha256=2165e8f2217f473974a21f1c5538aa6887d1df56fbabfa11319226dfbfa180a3

base=${1:-main}
cache="${XDG_CACHE_HOME:-$HOME/.cache}/octoflow-gate/$gate_commit"
gate="$cache/gate.py"

if [[ ! -f $gate ]]; then
	mkdir -p "$cache"
	tmp=$(mktemp "$cache/gate.py.XXXXXX")
	trap 'rm -f "$tmp"' EXIT
	curl -fsSL "https://raw.githubusercontent.com/DavidSiegl/octoflow-ai/$gate_commit/gate.py" -o "$tmp"
	if ! echo "$gate_sha256  $tmp" | sha256sum --check --status; then
		echo "gate: downloaded gate.py does not match the pinned SHA-256" >&2
		exit 2
	fi
	mv "$tmp" "$gate"
fi

cd "$(git rev-parse --show-toplevel)"
uv run pytest --cov=hyprmuse --cov-branch --cov-report=xml --junitxml=test-results.xml || true
uv run python "$gate" --base "$base" --tests test-results.xml --coverage coverage.xml --out quality.md
