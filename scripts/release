#!/bin/sh
# Decides what a change releases, and releases it: the one home of which paths reach users
# and of how release versions compare. From the agent-estate template; `copier update`
# rewrites it, so change the template, not this copy.
#
#   scripts/release changed BASE
#       Exit 0 when the change from BASE to HEAD touches a released path, 1 when it
#       touches only exempt ones, 2 on an error (BASE unknown). Jenkins's Package stage
#       builds only on 0, so a change to docs alone builds nothing.
#   scripts/release raised TARGET
#       Fetch origin's TARGET branch, then exit 0 when HEAD's release version is greater
#       than TARGET's, or when the change since their merge base touches only exempt
#       paths, saying so on standard output. Exit non-zero, saying why on standard error,
#       when it is not, or when a version or a git command fails. Jenkins's Version stage
#       runs it on a pull request into main, and auto-merge again right before merging,
#       since publish releases a merge into main only when its version has no release yet,
#       so a merge that kept main's version would go unreleased.
#   scripts/release publish
#       Create GitHub release v<version> at HEAD with gh (GH_TOKEN must allow it),
#       attaching every file in dist/release/, which scripts/package writes. Does nothing
#       when that release exists. Fails, creating nothing, when the version is below the
#       latest release, when scripts/package is executable but dist/release/ holds no
#       file, or when gh fails for any reason but a missing release.
#
# The release version is pyproject.toml's [project] version, read at the commit (HEAD,
# TARGET), not from the work tree. Versions compare as sort -V orders them, number by
# number, so 0.10.0 is greater than 0.9.0.
#
# Exempt paths, whose changes reach no user: EXEMPT below, plus the lines of the repo's own
# .release-exempt, one git glob pathspec per line (`assets` covers everything under
# assets/; `*` does not cross a /), blank lines ignored and `#` starting a comment. Any
# other path is released, so a path left off errs towards a raise. `changed` reads
# .release-exempt at HEAD; `raised` reads it on TARGET, so a pull request's edit to it
# counts from the next pull request on, as scripts/gate reads its rules at BASE.
set -eu
# Every pattern here is a git pathspec, which git expands; the shell must not.
set -f

# Docs (Markdown at the top level and under docs/ only: Markdown elsewhere may ship),
# tests, CI and the template's own tooling. scripts/package is left out on purpose: it
# builds what users get.
EXEMPT='docs
*.md
tests
scripts/gate
scripts/release
Jenkinsfile
.github
.gitignore
.copier-answers.yml
.release-exempt'

usage() {
    echo "usage: scripts/release changed BASE | raised TARGET | publish" >&2
    exit 2
}

# The exempt paths that hold at REV: EXEMPT and REV's .release-exempt, one per line,
# comments and blank lines dropped.
exempt_at() {
    extra=
    if git cat-file -e "$1:.release-exempt" 2>/dev/null; then
        extra=$(git show "$1:.release-exempt")
    fi
    printf '%s\n%s\n' "$EXEMPT" "$extra" |
        sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d'
}

# Returns 0 when the diff from REV ($1) to HEAD touches a path not in the exempt list $2
# (exempt_at's output), 1 when it does not, 2 when git fails.
touches_released() {
    # sh has no locals: these names are this function's alone, so callers keep theirs.
    diff_rev=$1 diff_exempt=$2
    set --
    saved_ifs=$IFS
    IFS='
'
    for path in $diff_exempt; do
        set -- "$@" ":(exclude,glob)$path"
    done
    IFS=$saved_ifs
    diff_status=0
    git diff --quiet "$diff_rev" HEAD -- . "$@" || diff_status=$?
    case $diff_status in
        0) return 1 ;;
        1) return 0 ;;
        *) return 2 ;;
    esac
}

# Prints pyproject.toml's [project] version at REV; exits 1, saying so, when it has none.
# Read apart from the parse: sh has no pipefail, so a failing git show in a pipeline would
# read as "no version" instead of stopping the script.
version_at() {
    text=$(git show "$1:pyproject.toml")
    version=$(printf '%s\n' "$text" |
        sed -n '/^\[project\]$/,/^\[/s/^version = "\([^"]*\)"$/\1/p' | head -n 1)
    if [ -z "$version" ]; then
        echo "scripts/release: no [project] version in pyproject.toml at $1" >&2
        exit 1
    fi
    echo "$version"
}

# Returns 0 when version $1 is greater than version $2.
version_greater() {
    [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]
}

changed() {
    exempt=$(exempt_at HEAD)
    status=0
    touches_released "$1" "$exempt" || status=$?
    exit "$status"
}

raised() {
    target=$1
    git fetch --quiet origin "+refs/heads/$target:refs/remotes/origin/$target"
    exempt=$(exempt_at "origin/$target")
    base=$(git merge-base HEAD "origin/$target")
    status=0
    touches_released "$base" "$exempt" || status=$?
    case $status in
        0) ;;
        1) echo "scripts/release: the change since $target touches only exempt paths;" \
               "nothing to release"
           exit 0 ;;
        *) exit 1 ;;
    esac
    old=$(version_at "origin/$target")
    new=$(version_at HEAD)
    if ! version_greater "$new" "$old"; then
        echo "scripts/release: pyproject.toml's version is $new, not greater than" \
            "$target's $old; raise it with uv version --bump, or the merge goes unreleased" >&2
        exit 1
    fi
}

publish() {
    version=$(version_at HEAD)
    tag="v$version"
    err=$(mktemp)
    trap 'rm -f "$err"' EXIT

    # Prints the tag of release $1, or of the latest with no argument. Returns 0 for a
    # release, 1 for none, and 2 for any other error, such as a bad token, which each
    # caller stops on rather than release twice or over a newer one.
    release_tag() {
        if gh release view "$@" --json tagName --jq .tagName 2>"$err"; then
            return 0
        fi
        grep -q 'release not found' "$err" && return 1
        cat "$err" >&2
        return 2
    }

    found=0
    release_tag "$tag" >/dev/null || found=$?
    case $found in
        0) echo "$tag is already released"; exit 0 ;;
        1) ;;
        *) exit 1 ;;
    esac
    found=0
    latest=$(release_tag) || found=$?
    [ "$found" -le 1 ] || exit 1
    if [ -n "$latest" ] && version_greater "${latest#v}" "$version"; then
        echo "scripts/release: pyproject.toml's version $version is below the latest" \
            "release $latest" >&2
        exit 1
    fi

    set +f
    set -- dist/release/*
    set -f
    [ -f "$1" ] || set --
    if [ -x scripts/package ] && [ $# -eq 0 ]; then
        echo "scripts/release: scripts/package left no file in dist/release/; run it first" >&2
        exit 1
    fi
    gh release create "$tag" "$@" --target "$(git rev-parse HEAD)" --title "$tag" \
        --generate-notes
}

case ${1:-} in
    changed) [ $# -eq 2 ] || usage; changed "$2" ;;
    raised) [ $# -eq 2 ] || usage; raised "$2" ;;
    publish) [ $# -eq 1 ] || usage; publish ;;
    *) usage ;;
esac
